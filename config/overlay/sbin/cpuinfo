#!/bin/sh
# LuCI 概览页「Architecture」数据源：rpcd 调用 /sbin/cpuinfo
# 输出形如：ARMv8 Processor rev 4 x 4 (1300MHz)
# 频率走 /sbin/cpufreq_real：PLL 寄存器直读优先（真值，含 luci-app-airoha-npu
# 的 PLL 直写超频——cpufreq sysfs 感知不到寄存器直写），cpufreq sysfs 兜底。
# 温度不在此显示（概览温度行已按需求移除，避免与架构行重复显示）。
CPUINFO="/proc/cpuinfo"

arch="$(awk -F': ' '/^model name/ {print $2; exit}' "$CPUINFO")"
[ -n "$arch" ] || arch="$(awk -F': ' '/^Processor/ {print $2; exit}' "$CPUINFO")"
[ -n "$arch" ] || arch="$(awk -F': ' '/^Hardware/ {print $2; exit}' "$CPUINFO")"
[ -n "$arch" ] || arch="$(uname -m)"

cores="$(grep -c '^processor' "$CPUINFO")"
[ "$cores" -ge 1 ] 2>/dev/null || cores=1

freq=""
freqk="$(/sbin/cpufreq_real 2>/dev/null)"
case "$freqk" in ''|*[!0-9]*) freqk="" ;; esac
[ -n "$freqk" ] && freq="$(awk -v k="$freqk" 'BEGIN{printf "%.0fMHz", k / 1000}')"

if [ -n "$freq" ]; then
	printf '%s x %s (%s)' "$arch" "$cores" "$freq"
else
	printf '%s x %s' "$arch" "$cores"
fi
