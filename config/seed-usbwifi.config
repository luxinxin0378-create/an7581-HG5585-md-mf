# ============================================================
# 测试版专用 .config 种子：在标准 md 固件基础上启用 USB 无线网卡
# 仅用于 xg-040g-md（无内置 WiFi），不参与正式构建
# 与 config/seed.config 的差异全部集中在文件末尾的 USB WiFi 段
# ============================================================

# ---- 目标平台: airoha / an7581 (aarch64 cortex-a53) ----
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_BOARD="airoha"
CONFIG_TARGET_SUBTARGET="an7581"
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---- LuCI 基础 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---- 主题：Argon ----
CONFIG_PACKAGE_luci-theme-argon=y

# ---- ONU 插件 ----
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-app-pon-status=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-pon-debug=y

# ---- NPU 状态面板 ----
CONFIG_PACKAGE_luci-app-airoha-npu=y

# ---- 概览页 CPU 频率/温度 ----
CONFIG_PACKAGE_autocore=y

# ---- 硬件加密引擎 EIP93 ----
CONFIG_PACKAGE_kmod-crypto-hw-eip93=y
CONFIG_PACKAGE_kmod-cryptodev=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_libopenssl-devcrypto=y

# ---- QModem ----
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_qmodem=y

# ---- USB 4G/5G 模组驱动 ----
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_chat=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_qmodem_INCLUDE_ADD_MTK_T7XX_SUPPORT=y
CONFIG_PACKAGE_kmod-mtk-t7xx=y

# ---- OpenClash ----
CONFIG_PACKAGE_luci-app-openclash=y

# ---- Passwall ----
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_xray-core=y

# ---- CPU 调节 ----
CONFIG_PACKAGE_luci-app-cpufreq=y

# ============================================================
# USB 无线网卡（测试版新增）
# ============================================================

# 11ac / 11ax 特性开关是 hostapd 的隐藏符号，默认 n；
# 无线驱动包的 DEPENDS 里带 @DRIVER_11AX_SUPPORT，不开则包会被 defconfig 丢弃。
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y

# 无线核心：cfg80211 + mac80211 + 完整版 wpad（含 802.11r/k/v、WPA3）
# 注意：这些都来自 package/kernel/mac80211（backports 独立源码树），
# 不需要内核 CONFIG_WLAN，也不要动 target/linux 的 config-6.18
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y

# USB 主控（md 的 DEVICE_PACKAGES 里没有 kmod-usb3，需显式补齐）
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y

# MediaTek mt76 系列（首选方案）
#   mt7921u = MT7921AU  WiFi 6，2.4/5G 双频，AP 模式成熟，性价比最高
#   mt7925u = MT7925    WiFi 7，价格较高
#   mt76x2u = MT7612U   WiFi 5，老卡常见
#   mt7663u = MT7663    WiFi 5
CONFIG_PACKAGE_kmod-mt7921u=y
CONFIG_PACKAGE_kmod-mt7925u=y
CONFIG_PACKAGE_kmod-mt76x2u=y
CONFIG_PACKAGE_kmod-mt7663u=y

# Realtek rtw88 主线驱动（覆盖市面大量廉价卡）
#   8812au / 8814au / 8821cu / 8822bu / 8822cu / 8723du
CONFIG_PACKAGE_kmod-rtw88-8812au=y
CONFIG_PACKAGE_kmod-rtw88-8814au=y
CONFIG_PACKAGE_kmod-rtw88-8821cu=y
CONFIG_PACKAGE_kmod-rtw88-8822bu=y
CONFIG_PACKAGE_kmod-rtw88-8822cu=y
CONFIG_PACKAGE_kmod-rtw88-8723du=y

# Atheros AR9271 / AR7010（最老最稳，2.4G only）
CONFIG_PACKAGE_kmod-ath9k-htc=y
