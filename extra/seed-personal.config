# =============================================================
# 个人精简版 seed（xg-040g-md / xg-040g-mf 专用，按用户指定）
# 只含：PON 基础栈 + LuCI(简体中文) + Argon 主题
#       + QModem 全功能(v3.2.0) + OpenClash(插件不带内核)
#       + USB 4G/5G 驱动
#       + 调优三件套：BBR / RPS / 代理调优+DNS缓存（体积近零纯配置）
# 明确不含：主题(Aurora/Vantage)、Passwall、airoha-npu 界面以外的调试包
# =============================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# ---- PON / ONU 基础（光口认证拨号核心） ----
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-app-pon-status=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-pon-debug=y
# ---- QModem 全功能 (v3.2.0；hc 为 mediatek 专用不含) ----
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_qfirehose=y
# QModem v3.2.0 包按依赖链分两派，互斥（抢 11_modem.js / init 脚本）：
#   next 派：luci-app-qmodem-next（主界面，自带短信列表/会话/转发配置/SIM 四页）
#            + monitor（硬依赖 next）+ sms-forwarder-next（next 硬依赖）
#   老版派：luci-app-qmodem + sms 界面 + mwan + sms-forwarder(传统版)
# 选 next 派：短信 UI 内置于主界面（sms_forward.js 配转发），保留监控；
#            老版派整体放弃（mwan/ttl 版依赖老界面，无法共存）
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_luci-app-qmodem-monitor=y
CONFIG_PACKAGE_sms-forwarder-next=y
# TTL fw4 版仅依赖 luci-base，不参与两派互斥，保留
CONFIG_PACKAGE_luci-app-qmodem-ttlfw4=y
# ---- NPU 监控 + CPU 频率控制 + PLL 超频 (rchen14b 版，支持 AN7581/AN7583) ----
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
# 超频/寄存器读取依赖：busybox devmem applet + 内核 /dev/mem
# （busybox 子项默认锁定，必须先开 BUSYBOX_CUSTOM 才能手动选 DEVMEM）
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_KERNEL_DEVMEM=y
# ---- CPU 频率调节（luci feed，系统菜单里的 CPU 超频/调频选项） ----
CONFIG_PACKAGE_luci-app-cpufreq=y
# ---- EIP93 硬件加密引擎（AES/DES 加速，与 devcrypto 用户态接口） ----
CONFIG_PACKAGE_kmod-crypto-hw-eip93=y
CONFIG_PACKAGE_kmod-cryptodev=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
# ---- USB 4G/5G 驱动 ----
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_chat=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_qmodem_INCLUDE_ADD_MTK_T7XX_SUPPORT=y
CONFIG_PACKAGE_kmod-mtk-t7xx=y
# ---- 内核调优：BBR 拥塞控制（kmod 自带 sysctl 落地，装上即生效） ----
CONFIG_PACKAGE_kmod-tcp-bbr=y
# ---- 系统工具：htop 进程/资源监控 ----
CONFIG_PACKAGE_htop=y
# ---- OpenClash（仅插件，内核由用户自行下载） ----
CONFIG_PACKAGE_luci-app-openclash=y
# ---- PassWall（Openwrt-Passwall 官方 feed）+ Xray 核心 ----
# 用户指定：PassWall 内置 Xray 核心开箱即用；内核为 INCLUDE_* 开关式，
# SingBox/SS-Rust 等其余内核与插件全部显式关闭（覆盖 aarch64 默认全开）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
# ---- NPU 硬件流卸载：flowtable 内核支持（fw4 硬件卸载开关的前提；
#      airoha generic config 未编入 NF_FLOW_TABLE，95-npu-offload uci-defaults 默认开）----
CONFIG_PACKAGE_kmod-nft-offload=y
# ---- 概览页温度/频率读数（autocore 提供 rpcd ACL + /sbin/cpuinfo、tempinfo 脚本） ----
CONFIG_PACKAGE_autocore=y
# ---- Argon 主题（immortalwrt 官方 feed 收录，设为默认） ----
CONFIG_PACKAGE_luci-theme-argon=y
# ---- USB 存储 / NAS：硬盘挂载 + SMB 共享（ksmbd 内核态，比 samba4 轻量好配）+ DLNA 车机点播 + 磁盘管理 ----
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-app-minidlna=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_filebrowser=y
# ---- 下载工具：qBittorrent（BT/磁力主力，WebUI :8080）+ aria2（HTTP/FTP 直链轻量） ----
CONFIG_PACKAGE_qbittorrent=y
CONFIG_PACKAGE_luci-app-qbittorrent=y
CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_luci-app-aria2=y
# ---- 脚本运行环境：插件脚本依赖（bash+curl+jq 约1.5MB） ----
# python3 声明已移除：若有插件 DEPENDS 依赖会由 make defconfig 自动带出，
# 无依赖则固件直接省 ~6MB。
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
# ---- 构建加速（不进固件） ----
CONFIG_CCACHE=y

# ---- 常用插件全家桶（全部中文界面） ----
# 网络唤醒：从外网经 ddnsto 唤醒家里电脑
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
# DNS 优化：SmartDNS 多上游测速加速（轻量，1G 内存友好）
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
# 硬盘休眠：空闲自动停转
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y
# UPnP：游戏机/P2P 自动端口映射
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
# 流量统计：按设备统计
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
# 智能队列限速：SQM/cake（nft-qos 已被上游删除）
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
# 上网时段管控：第三方单包仓库（clone 拷入，见 prepare-personal.sh 2.4c；
# lua 应用依赖的 luci-compat 已统一在「LuCI 基础」段声明，此处不再重复）
CONFIG_PACKAGE_luci-app-accesscontrol=y
CONFIG_PACKAGE_luci-i18n-accesscontrol-zh-cn=y
# 微信推送：tty228 版（clone 拷入，包名已由 serverchan 改为 wechatpush）
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y
CONFIG_PACKAGE_iputils-arping=y

# ---- 时区数据（LuCI 时区下拉列表需要；默认时区/NTP 由 uci-defaults 99-timezone 设为 Asia/Shanghai + 国内源） ----
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_zoneinfo-asia=y

# ---- 20261124 新增：测速 / ZeroTier / USB 打印机 / NFS / iStore 商店 ----
# 测速：LibreSpeed（本地 Go 后端，开箱即测；界面英文，其余全中文）
CONFIG_PACKAGE_luci-app-librespeed=y
CONFIG_PACKAGE_librespeed-go=y
# 测速编排链：librespeed-common 依赖的 librespeed-cli 无 + 前缀（普通依赖），
# 必须显式 =y，否则 select 链断裂导致 luci-app-librespeed 被 Kconfig 丢弃
CONFIG_PACKAGE_librespeed-cli=y
CONFIG_PACKAGE_librespeed-common=y
# 异地组网 ZeroTier（官方中文界面）
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
# USB 打印机共享 p910nd（官方中文界面）
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_kmod-usb-printer=y
# 2026 新版 OpenWrt hardware-support 元包：kmod-usb-printer 裸依赖 printer-support
# （DEFAULT:=m if ALL_KMODS，未显式开启时元包为 n，kmod-usb-printer 会被静默丢弃）
CONFIG_PACKAGE_printer-support=y
# NFS 共享（界面自动拉 nfs-utils/server-utils 全家）
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_luci-app-nfs=y
CONFIG_PACKAGE_luci-i18n-nfs-zh-cn=y
# iStore 应用商店（linkease，ipk/apk 双前端，中文内置）
CONFIG_PACKAGE_luci-app-store=y
# iStore kconfig 条件依赖（kmod 诊断确认）：busybox TAR_XZ=y 时强制要求
# xz-utils 包，否则 luci-app-store 符号整体隐藏、y 被静默清除
CONFIG_PACKAGE_xz-utils=y

# ---- IPTV 组播转单播：udpxy（官方 feed，中文界面） ----
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn=y

# ---- AdGuard Home 全屋去广告 DNS（官方 feed，Go 编译，中文界面） ----
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
